{
  "name": "keylet",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/keylet.node",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:bridge && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build:bridge": "bash ../scripts/build-bridge.sh",
    "build:release": "bash ../scripts/build-bridge.sh --universal && tsc -p tsconfig.json",
    "prepack": "pnpm run build:release"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "viem": "^2.0.0",
    "ethers-v5": "npm:ethers@^5.7.2",
    "ethers-v6": "npm:ethers@^6.0.0"
  },
  "description": "macOS Keychain-backed secp256k1 and Ed25519 keys for Node.js",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nivek3/keylet.git",
    "directory": "node"
  },
  "homepage": "https://github.com/nivek3/keylet#readme",
  "bugs": {
    "url": "https://github.com/nivek3/keylet/issues"
  },
  "keywords": [
    "macos",
    "keychain",
    "ethereum",
    "solana",
    "secp256k1",
    "ed25519",
    "napi-rs"
  ]
}
